{
  "feature": "Fetch with fallback",
  "gherkin": "Feature: Fetch with fallback\n\n  Scenario: Primary succeeds\n    Given a valid fetch request\n    When the primary source succeeds\n    Then return the primary result\n\n  Scenario: Primary fails with server error\n    Given a valid fetch request\n    When the primary source fails with a server error\n    Then fall back to the secondary source\n\n  Scenario: Primary fails with client error\n    Given a valid fetch request\n    When the primary source rejects the request\n    Then rethrow without falling back\n\n  Scenario: Primary fails with unknown error\n    Given a valid fetch request\n    When the primary source fails unexpectedly\n    Then log the unexpected error and rethrow",
  "cases": [
    {
      "input": { "url": "https://example.com/a", "retries": 1, "mode": "primary" },
      "output": { "data": { "id": "x1" }, "source": "primary" }
    },
    {
      "input": { "url": "https://example.com/b", "retries": 3, "mode": "primary" },
      "output": { "data": { "id": "x2" }, "source": "primary" }
    },
    {
      "input": { "url": "https://example.com/c", "retries": 0, "mode": "fallback" },
      "output": { "data": { "id": "x3" }, "source": "primary" }
    },
    {
      "input": { "url": "https://example.com/d", "retries": 0, "mode": "primary" },
      "output": { "data": { "id": "x6" }, "source": "primary" }
    },
    {
      "input": { "url": "https://primary-fails.example.com/a", "retries": 1, "mode": "primary" },
      "output": { "data": { "id": "x4" }, "source": "fallback" }
    },
    {
      "input": { "url": "https://primary-500.example.com/a", "retries": 0, "mode": "fallback" },
      "output": { "data": { "id": "x5" }, "source": "fallback" }
    },
    {
      "input": { "url": "https://primary-rejects.example.com/a", "retries": 0, "mode": "primary" },
      "output": { "error": { "name": "Error", "message": "primary source rejected the request", "status": 400 } }
    },
    {
      "input": { "url": "https://primary-rejects.example.com/b", "retries": 2, "mode": "fallback" },
      "output": { "error": { "name": "Error", "message": "primary source rejected the request", "status": 404 } }
    },
    {
      "input": { "url": "https://primary-unknown.example.com/a", "retries": 0, "mode": "primary" },
      "output": { "error": { "name": "Error", "message": "primary source failed unexpectedly" } }
    },
    {
      "input": { "url": "https://primary-unknown.example.com/b", "retries": 1, "mode": "fallback" },
      "output": { "error": { "name": "TypeError", "message": "unexpected response shape" } }
    }
  ]
}
